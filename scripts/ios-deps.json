{
  "$comment": "qemu-ios iOS arm64 交叉编译所需的最小依赖集。版本与 SHA256 直接取自源码包 contrib/portable/dependencies.json（LightTouch v0.0.13），保持一致。仓库不含任何 Apple 固件。",
  "source_manifest": "qemu-ios-lighttouch-v0.0.13/contrib/portable/dependencies.json",
  "target": "aarch64-apple-ios15.0",
  "packages": [
    {
      "name": "libffi",
      "archive": "libffi-3.4.6.tar.gz",
      "directory": "libffi-3.4.6",
