      "sha256": "b0dea9df23c863a7a50e825440f3ebffabd65df1497108e5d437747843895a4e",
      "build": "autotools",
      "note": "glib 依赖；iOS 需静态编译"
    },
    {
      "name": "proxy-libintl",
      "archive": "proxy-libintl-0.4.tar.gz",
      "directory": "proxy-libintl-0.4",
      "url": "https://codeload.github.com/frida/proxy-libintl/tar.gz/refs/tags/0.4",
      "sha256": "13ef3eea0a3bc0df55293be368dfbcff5a8dd5f4759280f28e030d1494a5dffb",
      "build": "meson",
      "note": "iOS 无系统 libintl，glib 需要"
    },
    {
      "name": "pcre2",
      "archive": "pcre2-10.44.tar.bz2",
      "directory": "pcre2-10.44",
      "url": "https://github.com/PCRE2Project/pcre2/releases/download/pcre2-10.44/pcre2-10.44.tar.bz2",
      "sha256": "d34f02e113cf7193a1ebf2770d3ac527088d485d4e047ed10e5d217c6ef5de96",
      "build": "autotools",
      "note": "glib 的正则后端"
    },
    {
      "name": "glib",
      "archive": "glib-2.80.0.tar.xz",
      "directory": "glib-2.80.0",
      "url": "https://download.gnome.org/sources/glib/2.80/glib-2.80.0.tar.xz",
      "sha256": "8228a92f92a412160b139ae68b6345bd28f24434a7b5af150ebe21ff587a561d",
      "build": "meson",
      "note": "QEMU 硬依赖。iOS cross build 需要关闭所有 cc.run() 运行测试，是最容易失败的一环"
    },
    {
      "name": "pixman",
      "archive": "pixman-0.44.2.tar.gz",
      "directory": "pixman-0.44.2",
      "url": "https://www.cairographics.org/releases/pixman-0.44.2.tar.gz",
      "sha256": "6349061ce1a338ab6952b92194d1b0377472244208d47ff25bef86fc71973466",
      "build": "meson",
      "note": "QEMU DisplaySurface 像素操作"
    },
    {
      "name": "openssl",
      "archive": "openssl-3.6.3.tar.gz",
      "directory": "openssl-3.6.3",
      "url": "https://github.com/openssl/openssl/releases/download/openssl-3.6.3/openssl-3.6.3.tar.gz",
      "sha256": "243a86649cf6f23eeb6a2ff2456e09e5d77dd9018a54d3d96b0c6bdd6ba6c7f1",
      "build": "openssl",
      "note": "iPod touch 2G 的 AES/PKE 设备模型直接调用 libcrypto"
    }
  ],
  "optional_not_built": [
    { "name": "ffmpeg", "reason": "hw/arm/meson.build 里 dependency('libavcodec', required: false)，缺失时走 gles-host-stub" },
    { "name": "libgcrypt", "reason": "可 --disable-gcrypt" },
    { "name": "libslirp", "reason": "可 --disable-slirp，iOS 上用户态网络另需重构" }
  ]
